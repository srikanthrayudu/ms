# Environment Configuration for RideShare Platform
# Copy this file to .env and adjust values as needed: cp .env.example .env

# Log level: debug, info, warn, error
# In debug mode, default JWT_SECRET is accepted.
# In production/info mode, JWT_SECRET must be at least 16 characters.
LOG_LEVEL=debug

# JWT Secret (MUST match across user-service and api-gateway)
JWT_SECRET=super-secret-change-me-production-key-32chars!

# Message broker URL
NATS_URL=nats://nats:4222

# Service Bindings
HTTP_ADDR=:8080
GRPC_USER_ADDR=:50051
GRPC_DRIVER_ADDR=:50052
GRPC_LOCATION_ADDR=:50053
GRPC_RIDE_ADDR=:50054
GRPC_PAYMENT_ADDR=:50055
GRPC_NOTIFICATION_ADDR=:50056
